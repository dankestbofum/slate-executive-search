# Copy to .env for local development only. This file is read when NODE_ENV is
# not "production" and not "test"; in production the platform environment is
# authoritative and .env is ignored entirely.

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MODEL_PREMIUM=claude-opus-5
PORT=4173
HOST=0.0.0.0
NODE_ENV=development

# Persist search files. On Render, attach a persistent disk mounted at /data.
# The Render blueprint sets DATA_DIR=/data/clean-owner for the clean workspace.
# DATA_DIR=/data

# Seeded consultant accounts. A Clerk identity with one of these verified
# emails signs in as that account. Optional:
# SLATE_EMAIL_TEAM=team@slate.local
# SLATE_EMAIL_ABE=abe@slate.local
# SLATE_EMAIL_MIKE=mike@slate.local

# Trust only the actual deployment proxy IPs/subnets. Empty ignores forwarded IPs.
# TRUST_PROXY=127.0.0.1/32,::1/128

# Recovery (see docs/operations.md). Snapshots run in-process on a timer.
# SLATE_BACKUP_INTERVAL_MINUTES=60
# Off-volume copy. Must be outside DATA_DIR; a copy on the volume it protects
# is not a second failure domain. Use one of these.
# SLATE_BACKUP_MIRROR=/mnt/offsite/slate
# SLATE_BACKUP_COMMAND=rclone copy --config /etc/rclone.conf
# Optional encryption before the copy leaves the host, 32 bytes hex or base64.
# An encrypted backup with a lost key is not a backup: store this off-host.
# SLATE_BACKUP_KEY=

# AI limits (DEP-11). Bounds on spend, not on ordinary work. Run
# `npm run preflight` to check the key and model entitlement without spending.
# SLATE_AI_MAX_CALLS_PER_SEARCH=200
# SLATE_AI_MAX_CALLS_PER_DAY=500
# SLATE_AI_MAX_USD_PER_DAY=25
# SLATE_AI_MAX_CONCURRENT=3
# Per-provider-call ceiling. Must sit inside the host's own request timeout, or
# the browser sees a gateway error while the call keeps running and keeps
# billing. Research reads this as the ceiling for ONE model round, not for the
# whole operation; lowering it lowers the round timeout.
# SLATE_AI_TIMEOUT_MS=180000
# SLATE_AI_RETRIES=1

# Research limits. Research is a crawl plus several model rounds plus a write,
# so it is bounded as one operation rather than per call. Values outside the
# ranges below are clamped, because a limit one typo can remove is not a limit.
#
# The whole operation, including time spent waiting for a free slot
# (15,000 - 900,000 ms).
# SLATE_RESEARCH_TIMEOUT_MS=180000
# Reading the jurisdiction's own website, inside the total (1,000 - 120,000 ms).
# SLATE_RESEARCH_CRAWL_TIMEOUT_MS=25000
# One model round, additionally capped by SLATE_AI_TIMEOUT_MS and by the time
# left (5,000 - 600,000 ms).
# SLATE_RESEARCH_ROUND_TIMEOUT_MS=60000
# Model rounds for the whole operation, continuations and the page-only
# fallback included (1 - 8).
# SLATE_RESEARCH_MAX_ROUNDS=4
# Set to "off" to serve the synchronous research contract only. Present for
# rollback; the durable job contract is the default.
# SLATE_RESEARCH_JOBS=on

# Shown to candidates on their questionnaire page. Until the privacy notice is
# set, the page reports it as missing rather than implying one was given.
# SLATE_CANDIDATE_INSTRUCTIONS=
# SLATE_PRIVACY_NOTICE=
# SLATE_TIMEZONE=America/Phoenix

# Alerts (docs/operations.md). Without a destination, conditions are logged and
# reported on /api/ready but nobody is notified.
# SLATE_ALERT_WEBHOOK=https://hooks.example.com/slate
# SLATE_ALERT_COMMAND=/usr/local/bin/notify

# Support and accommodation contact shown to candidates on their questionnaire.
# Until set, the page reports support as unavailable rather than showing a
# contact nobody reads.
# SLATE_SUPPORT_EMAIL=
# SLATE_SUPPORT_PHONE=
# SLATE_SUPPORT_HOURS=

# ---------------------------------------------------------------------------
# The public careers portal (/careers).
#
# Everything below is off by default, and the application says so rather than
# pretending otherwise: a posting published on a deployment with no mail
# provider is a readable advertisement with a support contact, and it does not
# offer an application form it cannot complete. /api/ready reports the state of
# all three.
# ---------------------------------------------------------------------------

# Where a published posting lives, for the address shown to staff and put in
# the confirmation email. Leave unset and it is taken from the request, which
# is right on every host the application answers on.
# SLATE_PUBLIC_URL=https://slate.example.com

# Mail. Applicant email verification is a launch dependency for online
# applications: without it nobody can prove an address or return to a saved
# application, and the portal refuses to offer the flow.
#   none  (default) nothing is sent, and every caller is told so
#   log             written to the process log, marked as not delivered
#   echo            returned to the caller; the test suite only, and refused
#                   outright under NODE_ENV=production
#
# None of these deliver to a real mailbox, so /api/ready reports
# portal.mail.productionCapable: false on every deployment, and under
# NODE_ENV=production the portal offers no email flow at all — including on
# `log`, which would otherwise tell an applicant a code was on its way and put
# it in a log file they cannot read.
#
# A real provider is an operations decision: sender domain, SPF and DKIM,
# bounce and complaint handling, and a suppression list. server/mailer.js has
# one function to replace and one list to add the transport's name to. The
# setup checklist is docs/release-process.md.
# SLATE_MAIL_TRANSPORT=none

# Application materials. Accepting uploads from the public is a change to the
# operating model in which Slate records where a document is and never holds
# one, so it is opt-in. Switching it on makes Slate a storage location for
# candidate documents, with the privacy, retention and legal-hold consequences
# set out in docs/search-operating-procedure.md section 5b.
#
# Mind the volume. Materials live on the app's disk and every snapshot copies
# them, so the disk has to hold the resumes times the retention windows above
# plus the store. The Render blueprint mounts 1 GB; a busy posting will need
# more than that, or a shorter window, or object storage.
# SLATE_APPLICATION_UPLOADS=on

# Recovery retention. This is the operational window for undoing a bad write or
# a bad migration. It is NOT records retention: nothing here expires a record,
# and a swept snapshot is not a deleted record. See docs/operations.md section 6.
#
# The sweep only ever removes a directory whose name Slate generated on a
# schedule — a bare date, or a bare timestamp. Anything else is protected
# whatever its age: pre-migration copies, hand-labelled copies, legal holds. To
# keep a snapshot indefinitely, rename it.
#
# How many daily snapshots to keep (default 14, minimum 1).
# SLATE_BACKUP_KEEP_DAYS=14
#
# How many scheduled (hourly by default) snapshots to keep — the rolling
# recovery window (default 24, minimum 1). Counted in snapshots rather than
# days because that is what bounds the disk: the interval is configurable, so
# "a day of snapshots" is not a fixed number of copies but this is. At the
# default hourly interval, 24 is one day.
#
# These snapshots were previously not swept at all, because the sweep did not
# recognise the name the scheduler writes. On a 1 GB volume carrying applicant
# PDFs, twenty-four full copies a day fills the disk in days and the first
# symptom is saves failing.
# SLATE_RECOVERY_KEEP_SNAPSHOTS=24

# Virus scanning for those uploads.
#   none        (default) files are stored and are NOT available to reviewers
#   accept-all  a development setting: files are openable without being
#               scanned, and the record keeps scanned:false so nobody later
#               reads the state as evidence that a scan happened.
#               REFUSED under NODE_ENV=production, where it resolves to `none`
#               and logs a warning — the same rule as the mail echo transport.
#
# There is no real scanner implementation, so /api/ready reports
# portal.files.productionCapable: false on every deployment. Running a public
# intake means either turning uploads off or configuring a real scanner; see
# docs/search-operating-procedure.md section 5c.
# SLATE_FILE_SCANNER=none

# Set by CI at image build time (--build-arg SLATE_RELEASE). Reported at startup
# and on /api/health so a running container is traceable to its commit. Leave
# unset locally; it reports "dev".
# SLATE_RELEASE=

# Clerk authentication (clerk init or clerk env pull supplies the keys).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Organization subscriptions: off (default), test, or live. Both Clerk keys
# must match the mode. Enable organization Billing and publish plans in Clerk.
# Candidates never need a paid plan. This does not yet impose a search paywall.
SLATE_BILLING_MODE=off
# Trusted app origins in production, comma-separated (e.g. https://slate.example.com).
CLERK_AUTHORIZED_PARTIES=
# Where Clerk sends someone who follows an organization invitation. Leave unset
# to use Clerk's own default for the instance.
# SLATE_INVITATION_REDIRECT_URL=
#
# Who may create a NEW firm workspace; comma-separated verified emails. Only
# consulted in production, where an empty list means nobody — the sign-up page
# is reachable by anyone who has the URL, and everybody else should arrive by
# invitation. Locally it is open, so this can stay unset.
# SLATE_WORKSPACE_FOUNDERS=
#
# There is no operator email allowlist any more. Access comes from membership in
# a Clerk organization and nothing else: the first person at a firm signs in and
# creates their workspace, which makes them its administrator, and they invite
# everybody else from Team & access. Enable Organizations on the Clerk instance
# and register the custom roles org:consultant and org:committee alongside the
# built-in org:admin before anybody signs in.
