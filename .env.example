# Copy to .env for local development only. This file is read when NODE_ENV is
# not "production" and not "test"; in production the platform environment is
# authoritative and .env is ignored entirely.

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MODEL_PREMIUM=claude-opus-5
PORT=4173
HOST=0.0.0.0
NODE_ENV=development

# Persist search files. On Railway, attach a volume and set this to the mount path.
# Production will refuse to start without DATA_DIR or RAILWAY_VOLUME_MOUNT_PATH.
# DATA_DIR=/data

# Seeded consultant accounts. A Clerk identity with one of these verified
# emails signs in as that account. Optional:
# SLATE_EMAIL_TEAM=team@slate.local
# SLATE_EMAIL_ABE=abe@slate.local
# SLATE_EMAIL_MIKE=mike@slate.local

# Trust only the actual deployment proxy IPs/subnets. Empty ignores forwarded IPs.
# TRUST_PROXY=127.0.0.1/32,::1/128

# Recovery (see docs/operations.md). Snapshots run in-process on a timer.
# SLATE_BACKUP_INTERVAL_MINUTES=60
# Off-volume copy. Must be outside DATA_DIR; a copy on the volume it protects
# is not a second failure domain. Use one of these.
# SLATE_BACKUP_MIRROR=/mnt/offsite/slate
# SLATE_BACKUP_COMMAND=rclone copy --config /etc/rclone.conf
# Optional encryption before the copy leaves the host, 32 bytes hex or base64.
# An encrypted backup with a lost key is not a backup: store this off-host.
# SLATE_BACKUP_KEY=

# AI limits (DEP-11). Bounds on spend, not on ordinary work. Run
# `npm run preflight` to check the key and model entitlement without spending.
# SLATE_AI_MAX_CALLS_PER_SEARCH=200
# SLATE_AI_MAX_CALLS_PER_DAY=500
# SLATE_AI_MAX_USD_PER_DAY=25
# SLATE_AI_MAX_CONCURRENT=3
# Must sit inside the host's own request timeout, or the browser sees a gateway
# error while the call keeps running and keeps billing.
# SLATE_AI_TIMEOUT_MS=180000
# SLATE_AI_RETRIES=1

# Shown to candidates on their questionnaire page. Until the privacy notice is
# set, the page reports it as missing rather than implying one was given.
# SLATE_CANDIDATE_INSTRUCTIONS=
# SLATE_PRIVACY_NOTICE=
# SLATE_TIMEZONE=America/Phoenix

# Alerts (docs/operations.md). Without a destination, conditions are logged and
# reported on /api/ready but nobody is notified.
# SLATE_ALERT_WEBHOOK=https://hooks.example.com/slate
# SLATE_ALERT_COMMAND=/usr/local/bin/notify

# Support and accommodation contact shown to candidates on their questionnaire.
# Until set, the page reports support as unavailable rather than showing a
# contact nobody reads.
# SLATE_SUPPORT_EMAIL=
# SLATE_SUPPORT_PHONE=
# SLATE_SUPPORT_HOURS=

# Set by CI at image build time (--build-arg SLATE_RELEASE). Reported at startup
# and on /api/health so a running container is traceable to its commit. Leave
# unset locally; it reports "dev".
# SLATE_RELEASE=

# Clerk authentication (clerk init or clerk env pull supplies the keys).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Verified emails eligible for NEW consultant accounts; comma-separated.
SLATE_CLERK_ADMIN_EMAILS=
# Trusted app origins in production, comma-separated (e.g. https://slate.example.com).
CLERK_AUTHORIZED_PARTIES=
