ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MODEL_PREMIUM=claude-opus-5
PORT=4173
HOST=0.0.0.0
NODE_ENV=development

# Persist search files. On Railway, attach a volume and set this to the mount path.
# Production will refuse to start without DATA_DIR or RAILWAY_VOLUME_MOUNT_PATH.
# DATA_DIR=/data

# First boot on an empty volume (production): required so default PINs are not seeded.
# SLATE_PIN_ABE=
# SLATE_PIN_MIKE=

# Set true only on a private machine. Never enable this on a public URL.
# SHOW_DEMO_LOGINS=true
